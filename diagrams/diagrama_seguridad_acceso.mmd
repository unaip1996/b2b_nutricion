%%{init: {"themeVariables": {"fontSize": "12px"}, "flowchart": {"nodeSpacing": 25, "rankSpacing": 28, "useMaxWidth": false}}}%%
classDiagram
    %% Disenado para impresion A4 vertical.
    direction TB

    class User {
        <<Doctrine Entity / Symfony Security User>>
        -Uuid id
        -string email
        -array roles
        -string password
        -DateTimeImmutable lastLogin
        +getUserIdentifier() string
        +getRoles() array
    }
    class NutritionistProfile {
        <<Doctrine Entity>>
        -Uuid id
    }
    class DoctrineEntityUserProvider {
        <<Doctrine user provider>>
        +loadUserByIdentifier() User
    }
    class JsonLoginAuthenticator {
        <<Symfony json_login firewall>>
        +authenticate() Passport
    }
    class JwtTokenIssuer {
        <<Lexik JWT success handler>>
        +createToken() string
    }
    class JwtAuthenticator {
        <<Lexik JWT firewall>>
        +authenticate() Passport
    }
    class ApiController {
        <<Protected API>>
        +requires ROLE_USER
    }
    User "1" *-- "0..1" NutritionistProfile : nutritionist profile
    DoctrineEntityUserProvider --> User : loads by email
    JsonLoginAuthenticator --> DoctrineEntityUserProvider : validates credentials
    JsonLoginAuthenticator --> JwtTokenIssuer : successful login
    JwtTokenIssuer --> User : token subject
    User --> JwtAuthenticator : JWT subject
    JwtAuthenticator --> ApiController : grants ROLE_USER access
