%%{init: {"themeVariables": {"fontSize": "12px"}, "flowchart": {"nodeSpacing": 18, "rankSpacing": 45, "useMaxWidth": false}}}%%
classDiagram
    %% Disenado para impresion A4 apaisada: entrada, aplicacion y salida.
    direction LR

    class IngestionController {
        <<Inbound adapter>>
        +upload() JsonResponse
    }
    class DietController {
        <<Inbound adapter>>
        +generateDiet() JsonResponse
    }
    class IngestClinicalDocumentUseCase {
        <<Application service>>
        +execute() array
    }
    class GenerateClinicalDietUseCase {
        <<Application service>>
        +execute() string
    }
    class PdfExtractorInterface {
        <<Outbound port>>
        +extractText() string
    }
    class TextChunkerInterface {
        <<Outbound port>>
        +chunkText() string[]
    }
    class EmbeddingGeneratorInterface {
        <<Outbound port>>
        +generateEmbedding() float[]
    }
    class LlmInferenceInterface {
        <<Outbound port>>
        +generateText() string
    }
    class DocumentChunkRepositoryInterface {
        <<Outbound port>>
        +save() void
        +findSimilar() DocumentChunk[]
    }
    class BasicPdfExtractor {
        <<Outbound adapter>>
    }
    class BasicTextChunker {
        <<Outbound adapter>>
    }
    class OpenAiEmbeddingAdapter {
        <<Outbound adapter>>
    }
    class OpenAiLlmAdapter {
        <<Outbound adapter>>
    }
    class DocumentChunkRepository {
        <<Persistence adapter>>
    }
    class PatientRepository {
        <<Persistence adapter>>
    }
    class EntityManagerInterface {
        <<Persistence gateway>>
    }

    IngestionController --> IngestClinicalDocumentUseCase : invokes
    DietController --> GenerateClinicalDietUseCase : invokes
    IngestClinicalDocumentUseCase --> PdfExtractorInterface
    IngestClinicalDocumentUseCase --> TextChunkerInterface
    IngestClinicalDocumentUseCase --> EmbeddingGeneratorInterface
    IngestClinicalDocumentUseCase --> EntityManagerInterface
    GenerateClinicalDietUseCase --> PatientRepository
    GenerateClinicalDietUseCase --> DocumentChunkRepository
    GenerateClinicalDietUseCase --> EmbeddingGeneratorInterface
    GenerateClinicalDietUseCase --> LlmInferenceInterface
    GenerateClinicalDietUseCase --> EntityManagerInterface
    BasicPdfExtractor ..|> PdfExtractorInterface
    BasicTextChunker ..|> TextChunkerInterface
    OpenAiEmbeddingAdapter ..|> EmbeddingGeneratorInterface
    OpenAiLlmAdapter ..|> LlmInferenceInterface
    DocumentChunkRepository ..|> DocumentChunkRepositoryInterface
